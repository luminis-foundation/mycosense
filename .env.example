# MycoSense Environment Config
# Copy to .env and fill in values for live hardware mode.
# Without VITE_SENSOR_WS_URL, the dashboard runs in mock mode automatically.
# Never commit a populated .env file.

# WebSocket URL for your sensor server / serial bridge
# Example: ws://192.168.1.50:8765
VITE_SENSOR_WS_URL=

# Raspberry Pi local server URL (defaults to mDNS hostname if unset)
# Example: http://192.168.4.1:8765
VITE_PI_URL=

# Bearer token for Pi server authentication.
# Must match MYCOSENSE_API_TOKEN set on the Pi.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️  NEVER set VITE_PI_TOKEN in Vercel or any public hosted deployment.
#     VITE_* variables are embedded in the browser bundle at build time —
#     anyone who inspects the built JS can read them. This means:
#       - Do NOT add VITE_PI_TOKEN as a Vercel environment variable
#       - Do NOT set it in any CI/CD pipeline that deploys publicly
#       - Production / live field authentication should NOT rely on
#         browser-held secrets
#     This variable is ONLY safe for local or private dashboard builds
#     where the Pi and the browser share a trusted LAN and the bundle
#     is not publicly accessible.
VITE_PI_TOKEN=
